SUPABASE_URL=
SUPABASE_KEY=

# Fase 4 (Sincronizador): credenciales de un usuario real de Supabase Auth
# (el mismo que usará el frontend después). El Sincronizador inicia sesión
# como este usuario antes de sincronizar, para que las políticas de RLS
# (user_id = auth.uid()) lo dejen insertar sus propios datos.
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# Opcionales (sync/gmail_gastos.py): dónde viven el JSON de cliente OAuth de Google y el
# permiso guardado. Por defecto data/gmail/credentials.json y data/gmail/token.json.
# GMAIL_CREDENTIALS_FILE=
# GMAIL_TOKEN_FILE=
