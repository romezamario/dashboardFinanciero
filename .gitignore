# Secretos
.env
.env.*
!.env.example

# PDFs y datos locales (nunca deben salir de la laptop)
data/nuevos/*
data/procesados/*
data/errores/*
!data/nuevos/.gitkeep
!data/procesados/.gitkeep
!data/errores/.gitkeep

# Reglas de categorización reales (revelan patrones de gasto personales)
transform/reglas_categorizacion.json
!transform/reglas_categorizacion.example.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Artefactos de PyInstaller (se regeneran con DashboardFinanciero.spec)
build/
dist/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# Editor / OS
.DS_Store
